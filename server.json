{
  "name": "io.github.sachio222/54ch10-mcp",
  "title": "54ch10",
  "version": "0.2.0",
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "description": "54ch10 MCP tools: pre-interact brief plus whois/RDAP, DNS, TLS/CT, and URL normalize against https://54ch10.uk. Analytics-only \u2014 not financial advice.",
  "websiteUrl": "https://54ch10.uk",
  "repository": {
    "url": "https://github.com/sachio222/54ch10-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "54ch10-mcp",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BRIEF_API_BASE",
          "description": "API base URL (default https://54ch10.uk)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "BRIEF_API_KEY",
          "description": "Optional paid key; empty for free/demo",
          "isRequired": false,
          "isSecret": true
        }
      ],
      "packageArguments": [
        {
          "description": "Primary install from public GitHub until registry.npmjs.org publish",
          "isRequired": false,
          "format": "string",
          "value": "github:sachio222/54ch10-mcp",
          "default": "github:sachio222/54ch10-mcp",
          "name": "package",
          "type": "positional"
        }
      ]
    }
  ]
}
